# Least-privilege udev rules for ZWO USB HID astronomy devices.
#
# pyzwohid (via hidapi-hidraw) communicates exclusively through Linux /dev/hidraw*
# nodes. It does not open /dev/bus/usb/* nodes and does not require sysfs USB driver
# bind/unbind access, drivers_autoprobe, device/hub power/level writes, or
# usbcore.usbfs_memory_mb tuning.
#
# Access model:
#   - Headless observatory services / daemons / SSH sessions (no active desktop seat):
#     GROUP="zwo", MODE="0660" grants read/write access only to root and members of the
#     dedicated "zwo" system group.
#   - Attended desktop Linux sessions:
#     TAG+="uaccess" allows systemd-logind to grant a dynamic POSIX ACL on the matched
#     /dev/hidraw* node to the active local seat user (the 70- prefix ensures this rule
#     runs before systemd's 73-seat-late.rules evaluates uaccess).
#   - Persistent port path symlink:
#     Standard systemd-udevd (60-persistent-input.rules) skips SUBSYSTEM=="hidraw"
#     devices and does not populate ID_PATH or /dev/input/by-path/ for ZWO HID nodes.
#     Importing builtin "path_id" here creates /dev/hidraw/by-path/<ID_PATH> symlinks
#     automatically for every attached ZWO HID device.
#
# Installation (requires root; never auto-installed by pyzwohid):
#   1. Create the dedicated device-access group and add your service/operator account:
#        sudo groupadd --system zwo
#        sudo usermod -aG zwo <user>
#   2. Install this rules file (from a git checkout or an installed Python environment)
#      and reload udev:
#        # From a git checkout:
#        sudo install -m 0644 pyzwohid/udev/70-pyzwohid.rules /etc/udev/rules.d/70-pyzwohid.rules
#        # Or from an installed package / virtualenv:
#        RULE_PATH="$(python3 -c 'import importlib.resources as r; print(r.files("pyzwohid") / "udev/70-pyzwohid.rules")')"
#        sudo install -m 0644 "$RULE_PATH" /etc/udev/rules.d/70-pyzwohid.rules
#
#        sudo udevadm control --reload-rules
#        sudo udevadm trigger --subsystem-match=hidraw
#   3. Re-login (or restart the systemd service) so supplementary group membership applies,
#      or replug the USB cable if udevadm trigger was not run.
#
# Optional per-product restriction:
#   By default, the rule below matches any ZWO USB HID device (ATTRS{idVendor}=="03c3").
#   To restrict access to specific product IDs only, add ATTRS{idProduct}=="<pid>",
#   for example:
#     # ZWO EFW (03c3:1f01; legacy/other EFWs may use 1f01 or 1f02)
#     SUBSYSTEM=="hidraw", KERNEL=="hidraw*", SUBSYSTEMS=="usb", ATTRS{idVendor}=="03c3", ATTRS{idProduct}=="1f01", IMPORT{builtin}="path_id", GROUP="zwo", MODE="0660", TAG+="uaccess", SYMLINK+="hidraw/by-path/$env{ID_PATH}"
#     # ZWO EAF (03c3:1f10)
#     SUBSYSTEM=="hidraw", KERNEL=="hidraw*", SUBSYSTEMS=="usb", ATTRS{idVendor}=="03c3", ATTRS{idProduct}=="1f10", IMPORT{builtin}="path_id", GROUP="zwo", MODE="0660", TAG+="uaccess", SYMLINK+="hidraw/by-path/$env{ID_PATH}"
#
# Optional persistent symlink pinned to a physical USB port:
#   ZWO USB descriptors do not expose a unique USB iSerial string, and /dev/hidrawN
#   indices can shift across reboots or USB replugs.
#   1. Pass the automatic /dev/hidraw/by-path/<ID_PATH> symlink created by this rule
#      directly to Efw.open() / Eaf.open(), e.g.:
#        /dev/hidraw/by-path/pci-0000:74:00.3-usb-0:2.3:1.0
#   2. Or walk the parent USB hierarchy in sysfs with "-a" to inspect the parent USB
#      port KERNELS identifier (e.g. KERNELS=="1-3" or KERNELS=="3-2.3"):
#        udevadm info -a /dev/hidraw0
#      and define a custom /dev/<name> symlink via SYMLINK+="...":
#        SUBSYSTEM=="hidraw", KERNEL=="hidraw*", SUBSYSTEMS=="usb", ATTRS{idVendor}=="03c3", ATTRS{idProduct}=="1f01", KERNELS=="3-2.3", GROUP="zwo", MODE="0660", TAG+="uaccess", SYMLINK+="zwo-efw"
#        SUBSYSTEM=="hidraw", KERNEL=="hidraw*", SUBSYSTEMS=="usb", ATTRS{idVendor}=="03c3", ATTRS{idProduct}=="1f10", KERNELS=="3-2.4", GROUP="zwo", MODE="0660", TAG+="uaccess", SYMLINK+="zwo-eaf"

SUBSYSTEM=="hidraw", KERNEL=="hidraw*", SUBSYSTEMS=="usb", ATTRS{idVendor}=="03c3", IMPORT{builtin}="path_id", GROUP="zwo", MODE="0660", TAG+="uaccess", SYMLINK+="hidraw/by-path/$env{ID_PATH}"
